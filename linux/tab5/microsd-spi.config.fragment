# Experimental microSD GPIO SPI; requires matching DTS and LDO4 boot shim.
# Keep the existing DW-MMC/SDIO Wi-Fi configuration unchanged.
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_BITBANG=y
CONFIG_SPI_GPIO=y
CONFIG_MMC=y
CONFIG_MMC_SPI=y
CONFIG_BLOCK=y
CONFIG_MMC_BLOCK=y
CONFIG_MSDOS_PARTITION=y
CONFIG_FAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
