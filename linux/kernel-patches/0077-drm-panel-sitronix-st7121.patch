+}
+
 static int st7123_prepare(struct drm_panel *panel)
 {
 	struct st7123 *ctx = panel_to_st7123(panel);
@@ -146,13 +243,18 @@
 	struct st7123 *ctx = panel_to_st7123(panel);
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
 
-	st7123_init_sequence(&dsi_ctx);
+	ctx->desc->init_sequence(&dsi_ctx);
 	/* Sleep-out and display-on take no parameter on this controller. */
 	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
-	mipi_dsi_msleep(&dsi_ctx, 120);
+	mipi_dsi_msleep(&dsi_ctx, ctx->desc->sleep_out_delay_ms);
 	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
-	mipi_dsi_msleep(&dsi_ctx, 50);
+	mipi_dsi_msleep(&dsi_ctx, ctx->desc->display_on_delay_ms);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_SET_TEAR_ON, 0x00);
+	if (of_device_is_compatible(ctx->dsi->dev.of_node, "sitronix,st7121")) {
+		mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_EXIT_INVERT_MODE);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_SET_ADDRESS_MODE, 0x00);
+	}
 	if (dsi_ctx.accum_err)
 		dev_err(&ctx->dsi->dev, "panel init failed: %d\n",
 			dsi_ctx.accum_err);
@@ -185,13 +287,43 @@
 	.height_mm	= 110,
 };
 
+/* BSP ST7121: 70 MHz, HFP/HSA/HBP 40/2/40, VFP/VSA/VBP 200/20/24. */
+static const struct drm_display_mode st7121_mode = {
+	.clock		= 70000,
+	.hdisplay	= 720,
+	.hsync_start	= 720 + 40,
+	.hsync_end	= 720 + 40 + 2,
+	.htotal		= 720 + 40 + 2 + 40,
+	.vdisplay	= 1280,
+	.vsync_start	= 1280 + 200,
+	.vsync_end	= 1280 + 200 + 20,
+	.vtotal		= 1280 + 200 + 20 + 24,
+	.flags		= DRM_MODE_FLAG_PHSYNC | DRM_MODE_FLAG_PVSYNC,
+	.width_mm	= 62,
+	.height_mm	= 110,
+};
+
+static const struct st712x_desc st7123_desc = {
+	.mode = &st7123_mode,
+	.init_sequence = st7123_init_sequence,
+	.sleep_out_delay_ms = 120,
+	.display_on_delay_ms = 50,
+};
+
+static const struct st712x_desc st7121_desc = {
+	.mode = &st7121_mode,
+	.init_sequence = st7121_init_sequence,
+	.sleep_out_delay_ms = 80,
+	.display_on_delay_ms = 800,
+};
+
 static int st7123_get_modes(struct drm_panel *panel,
 			    struct drm_connector *connector)
 {
 	struct st7123 *ctx = panel_to_st7123(panel);
 	struct drm_display_mode *mode;
 
-	mode = drm_mode_duplicate(connector->dev, &st7123_mode);
+	mode = drm_mode_duplicate(connector->dev, ctx->desc->mode);
 	if (!mode)
 		return -ENOMEM;
 	drm_mode_set_name(mode);
@@ -236,6 +368,9 @@
 	if (ret < 0)
 		return dev_err_probe(dev, ret, "cannot read orientation\n");
 
+	ctx->desc = of_device_get_match_data(dev);
+	if (!ctx->desc)
+		return -EINVAL;
 	ctx->dsi = dsi;
 	mipi_dsi_set_drvdata(dsi, ctx);
 
@@ -263,7 +398,8 @@
 }
 
 static const struct of_device_id st7123_of_match[] = {
-	{ .compatible = "sitronix,st7123" },
+	{ .compatible = "sitronix,st7123", .data = &st7123_desc },
+	{ .compatible = "sitronix,st7121", .data = &st7121_desc },
 	{ }
 };
 MODULE_DEVICE_TABLE(of, st7123_of_match);
@@ -278,5 +414,5 @@
 };
 module_mipi_dsi_driver(st7123_driver);
 
-MODULE_DESCRIPTION("Sitronix ST7123 MIPI-DSI panel driver");
+MODULE_DESCRIPTION("Sitronix ST7121/ST7123 MIPI-DSI panel driver");
 MODULE_LICENSE("GPL");
