From: Tab5 Linux FPGA maintainers
Subject: [PATCH] drm/panel: add ST7121 variant to Tab5 ST7123 driver

Select the ST7121 manufacturer register parameters, 70 MHz timing and
80/800 ms sleep-out/display-on delays with sitronix,st7121. Preserve the
existing sitronix,st7123 mode, init commands and delays. The command values
and timing come from the Espressif M5Stack Tab5 BSP 1.3.2, whose standalone
ESP-IDF display test has been verified on the ST7121 hardware.

This patch follows 0075; it does not change the board's default compatible
or DSI lane clock. ST7121 Linux display still requires hardware validation.

diff --git a/drivers/gpu/drm/panel/panel-sitronix-st7123.c b/drivers/gpu/drm/panel/panel-sitronix-st7123.c
--- a/drivers/gpu/drm/panel/panel-sitronix-st7123.c
+++ b/drivers/gpu/drm/panel/panel-sitronix-st7123.c
@@ -16,17 +16,26 @@
 #include <linux/mod_devicetable.h>
 #include <linux/module.h>
 #include <linux/of.h>
+#include <linux/of_device.h>
 
 #include <video/mipi_display.h>
 
 #include <drm/drm_mipi_dsi.h>
 #include <drm/drm_modes.h>
 #include <drm/drm_panel.h>
+
+struct st712x_desc {
+	const struct drm_display_mode *mode;
+	void (*init_sequence)(struct mipi_dsi_multi_context *ctx);
+	unsigned int sleep_out_delay_ms;
+	unsigned int display_on_delay_ms;
+};
 
 struct st7123 {
 	struct drm_panel panel;
 	struct mipi_dsi_device *dsi;
 	struct gpio_desc *reset;
+	const struct st712x_desc *desc;
 	enum drm_panel_orientation orientation;
 };
 
@@ -128,6 +137,94 @@
 	mipi_dsi_dcs_write_seq_multi(ctx, MIPI_DCS_SET_ADDRESS_MODE, 0x03);
 }
 
+/*
