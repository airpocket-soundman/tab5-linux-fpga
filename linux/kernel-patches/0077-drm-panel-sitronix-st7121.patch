+	mipi_dsi_dcs_write_seq_multi(ctx, 0x60, 0x71, 0x21, 0xa4);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x78, 0x21);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x79, 0xef);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xa4, 0x31);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xb7, 0x00, 0x00, 0x5f, 0x5f, 0x44, 0x1a);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xb0, 0x22, 0x6b, 0x11, 0x89, 0x25, 0x43, 0x43);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xbf, 0xa7, 0xa7);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xa5, 0xf0, 0x03);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xd7, 0x10, 0x2c, 0x14, 0x2a, 0x80, 0x80);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x90, 0x71, 0x23, 0x5a, 0x20, 0x24, 0x11, 0x21);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xa3,
+				     0x80, 0x01, 0x8c, 0xff, 0x45, 0x00, 0x00, 0x00,
+				     0x00, 0x00, 0x46, 0x00, 0x00, 0x1e, 0x5c, 0x1e,
+				     0x80, 0x10, 0x00, 0x05, 0x00, 0x00, 0x00, 0x00,
+				     0x00, 0x46, 0x00, 0x00, 0x1e, 0x5c, 0x1e, 0x80,
+				     0x10, 0xef, 0x58, 0x00, 0x00, 0x00, 0xff);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xa6,
+				     0x0a, 0x00, 0x24, 0x71, 0x36, 0x00, 0x00, 0x00,
+				     0x68, 0x68, 0x91, 0xff, 0x00, 0x24, 0x71, 0x37,
+				     0x00, 0x00, 0x00, 0x68, 0x68, 0x91, 0xff, 0x00,
+				     0x24, 0x71, 0x00, 0x00, 0x00, 0x00, 0x68, 0x68,
+				     0x91, 0xff, 0x00, 0x2c, 0x71, 0x00, 0x01, 0x00,
+				     0x00, 0x68, 0x68, 0xff, 0xff, 0x00, 0x08, 0x80,
+				     0x08, 0x80, 0x06, 0x00, 0x00, 0x00, 0x00);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xa7,
+				     0x1a, 0x1a, 0xc0, 0x64, 0x40, 0x04, 0x15, 0x40,
+				     0x00, 0x40, 0x00, 0x68, 0x68, 0x91, 0xff, 0x08,
+				     0x80, 0x64, 0x40, 0x26, 0x37, 0x40, 0x00, 0x00,
+				     0x00, 0x68, 0x68, 0x91, 0xff, 0x08, 0x80, 0x64,
+				     0x40, 0x8c, 0x9d, 0x40, 0x00, 0x00, 0x00, 0x68,
+				     0x68, 0x91, 0xff, 0x08, 0x80, 0x64, 0x40, 0xae,
+				     0xbf, 0x00, 0x00, 0x20, 0x00, 0x68, 0x68, 0x91,
+				     0xff, 0x08, 0x80, 0x79);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xac,
+				     0x1d, 0x18, 0x19, 0x1d, 0x18, 0x19, 0x04, 0x1c,
+				     0x1d, 0x08, 0x0a, 0x10, 0x12, 0x0c, 0x0e, 0x14,
+				     0x16, 0x00, 0x1d, 0x1d, 0x1d, 0x1d, 0x1d, 0x18,
+				     0x19, 0x1d, 0x18, 0x19, 0x06, 0x1c, 0x1d, 0x09,
+				     0x0b, 0x11, 0x13, 0x0d, 0x0f, 0x15, 0x17, 0x02,
+				     0x1d, 0x1d, 0x1d, 0x1d);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xad,
+				     0x0c, 0x40, 0x46, 0x00, 0x07, 0x4b, 0x4b, 0xff,
+				     0xff, 0xf0, 0x40, 0x0e, 0x01, 0x07, 0x42, 0x42,
+				     0xff, 0xff, 0x01, 0x00, 0x00, 0xff, 0xff, 0xff,
+				     0xff);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xae, 0xf0, 0xff, 0x03, 0xf0, 0xff, 0x03, 0x00);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xb2,
+				     0x15, 0x19, 0x05, 0x23, 0x49, 0x2d, 0x03, 0x2e,
+				     0x5c, 0xd2, 0xff, 0x10, 0x60, 0xfd, 0x20, 0xc0,
+				     0x00);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xe8,
+				     0x20, 0x60, 0x04, 0x8e, 0x8e, 0x3e, 0x04, 0xdc,
+				     0xdc, 0x3e, 0x06, 0xfa, 0x26, 0x3e);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x75, 0x03, 0x04);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xe7,
+				     0x4b, 0x00, 0x00, 0xbe, 0x4b, 0x8c, 0x20, 0x1a,
+				     0xf0, 0x7d, 0x14, 0x7d, 0x14, 0x7d, 0x14, 0x7d,
+				     0x14, 0xff, 0x00, 0x32, 0x30, 0x73, 0x00, 0x00,
+				     0xc8, 0x6a, 0xff, 0x5a, 0x64, 0x38, 0x88, 0x15,
+				     0xb1, 0x01, 0x01, 0x64, 0x01, 0x01, 0x7c, 0xff,
+				     0x1a, 0x51);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xe1, 0x0c, 0x0c);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xea, 0x15, 0x00, 0x01);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xc8,
+				     0x00, 0x00, 0x04, 0x08, 0x10, 0x00, 0x1f, 0x01,
+				     0x39, 0x3e, 0x00, 0x78, 0x06, 0xe2, 0x02, 0x11,
+				     0x33, 0x01, 0x7a, 0x0d, 0x21, 0xc4, 0x0b, 0x19,
+				     0x08, 0x32, 0xa0, 0x08, 0x1a, 0x0a, 0xf3, 0x7f,
+				     0x0e, 0xc5, 0xe8, 0x03, 0xff);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xc9,
+				     0x00, 0x00, 0x04, 0x08, 0x10, 0x00, 0x1f, 0x01,
+				     0x39, 0x3e, 0x00, 0x78, 0x06, 0xe2, 0x02, 0x11,
+				     0x33, 0x01, 0x7a, 0x0d, 0x21, 0xc4, 0x0b, 0x19,
+				     0x08, 0x32, 0xa0, 0x08, 0x1a, 0x0a, 0xf3, 0x7f,
+				     0x0e, 0xc5, 0xe8, 0x03, 0xff);
