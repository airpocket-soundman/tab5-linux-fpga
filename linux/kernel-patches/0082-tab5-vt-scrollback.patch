From: Tab5 Linux FPGA contributors
Subject: [PATCH] vt: add opt-in bounded tty1 glyph scrollback

--- a/drivers/tty/vt/vt.c
+++ b/drivers/tty/vt/vt.c
@@ -571,6 +571,50 @@
 	}
 }
 
+/* Tab5: bounded glyph history for tty1, serialized by console_lock. */
+#ifdef CONFIG_TAB5_VT_SCROLLBACK
+#define TAB5_HISTORY_LINES 128
+#define TAB5_HISTORY_COLS 160
+static struct {
+ u16 cells[TAB5_HISTORY_LINES][TAB5_HISTORY_COLS];
+ unsigned int cols, rows, head, count, offset;
+} tab5_history;
+
+static bool tab5_history_valid(struct vc_data *vc)
+{
+ if (vc->vc_num || !vc->vc_cols || vc->vc_cols > TAB5_HISTORY_COLS)
+  return false;
+ if (tab5_history.cols != vc->vc_cols || tab5_history.rows != vc->vc_rows) {
+  tab5_history.cols = vc->vc_cols;
+  tab5_history.rows = vc->vc_rows;
+  tab5_history.head = tab5_history.count = tab5_history.offset = 0;
+ }
+ return true;
+}
+
+static void tab5_history_push(struct vc_data *vc, unsigned int nr)
+{
+ unsigned int y, x;
+ if (!tab5_history_valid(vc))
+  return;
+ for (y = 0; y < nr; y++) {
+  u16 *src = (u16 *)(vc->vc_origin + y * vc->vc_size_row);
+  u16 *dst = tab5_history.cells[tab5_history.head];
+  for (x = 0; x < vc->vc_cols; x++)
+   dst[x] = scr_readw(src + x);
+  tab5_history.head = (tab5_history.head + 1) % TAB5_HISTORY_LINES;
+  if (tab5_history.count < TAB5_HISTORY_LINES)
+   tab5_history.count++;
+ }
+}
+static bool tab5_history_scroll(struct vc_data *vc, int delta);
+static void tab5_history_live(struct vc_data *vc);
+#else
+static inline void tab5_history_push(struct vc_data *vc, unsigned int nr) {}
+static inline bool tab5_history_scroll(struct vc_data *vc, int delta) { return false; }
+static inline void tab5_history_live(struct vc_data *vc) {}
+#endif
+
 static void con_scroll(struct vc_data *vc, unsigned int top,
 		       unsigned int bottom, enum con_scroll dir,
 		       unsigned int nr)
@@ -583,6 +627,8 @@
 	if (bottom > vc->vc_rows || top >= bottom || nr < 1)
 		return;
 
+	if (!top && bottom == vc->vc_rows && dir == SM_UP)
+		tab5_history_push(vc, nr);
 	vc_uniscr_scroll(vc, top, bottom, dir, nr);
 	if (con_is_visible(vc) &&
 			vc->vc_sw->con_scroll(vc, top, bottom, dir, nr))
@@ -632,6 +678,54 @@
 		yy++;
 	}
 }
+
+#ifdef CONFIG_TAB5_VT_SCROLLBACK
+static void tab5_history_live(struct vc_data *vc)
+{
+ if (vc->vc_num || !tab5_history.offset)
+  return;
+ tab5_history.offset = 0;
+ if (con_should_update(vc)) {
+  hide_cursor(vc);
+  do_update_region(vc, vc->vc_origin, vc->vc_screenbuf_size / 2);
+  set_cursor(vc);
+ }
+}
+
+static bool tab5_history_scroll(struct vc_data *vc, int delta)
+{
+ unsigned int y, x, oldest, index;
+ s64 offset;
+ if (!tab5_history_valid(vc))
+  return false;
+ if (!con_should_update(vc) || vc->vc_mode != KD_TEXT)
+  return true;
+ offset = (s64)tab5_history.offset - delta;
+ offset = clamp_t(s64, offset, 0, tab5_history.count);
+ if (!offset) {
+  tab5_history_live(vc);
+  return true;
+ }
+ tab5_history.offset = offset;
+ oldest = (tab5_history.head + TAB5_HISTORY_LINES - tab5_history.count) % TAB5_HISTORY_LINES;
+ hide_cursor(vc);
+ for (y = 0; y < vc->vc_rows; y++) {
+  const u16 *line;
+  index = tab5_history.count - tab5_history.offset + y;
+  if (index < tab5_history.count)
+   line = tab5_history.cells[(oldest + index) % TAB5_HISTORY_LINES];
+  else
+   line = (u16 *)(vc->vc_origin + (index - tab5_history.count) * vc->vc_size_row);
+  for (x = 0; x < vc->vc_cols;) {
+   unsigned int start = x;
+   u16 attr = scr_readw(line + x) & 0xff00;
+   do { x++; } while (x < vc->vc_cols && (scr_readw(line + x) & 0xff00) == attr);
+   vc->vc_sw->con_putcs(vc, line + start, x - start, y, start);
+  }
+ }
+ return true;
+}
+#endif
 
 void update_region(struct vc_data *vc, unsigned long start, int count)
 {
@@ -858,6 +952,10 @@
 
 static void set_cursor(struct vc_data *vc)
 {
+#ifdef CONFIG_TAB5_VT_SCROLLBACK
+	if (!vc->vc_num && tab5_history.offset)
+		return;
+#endif
 	if (!con_is_fg(vc) || console_blanked || vc->vc_mode == KD_GRAPHICS)
 		return;
 	if (vc->vc_deccm) {
@@ -894,6 +992,12 @@
 
 static void flush_scrollback(struct vc_data *vc)
 {
+#ifdef CONFIG_TAB5_VT_SCROLLBACK
+	if (!vc->vc_num) {
+		tab5_history_live(vc);
+		tab5_history.head = tab5_history.count = 0;
+	}
+#endif
 	WARN_CONSOLE_UNLOCKED();
 
 	set_origin(vc);
@@ -3225,6 +3329,8 @@
 	}
 
 
+	tab5_history_live(vc);
+
 	/* undraw cursor first */
 	if (con_is_fg(vc))
 		hide_cursor(vc);
@@ -3299,7 +3405,8 @@
 	if (scrollback_delta) {
 		struct vc_data *vc = vc_cons[fg_console].d;
 		clear_selection();
-		if (vc->vc_mode == KD_TEXT && vc->vc_sw->con_scrolldelta)
+		if (vc->vc_mode == KD_TEXT &&
+		    !tab5_history_scroll(vc, scrollback_delta) && vc->vc_sw->con_scrolldelta)
 			vc->vc_sw->con_scrolldelta(vc, scrollback_delta);
 		scrollback_delta = 0;
 	}
@@ -3402,6 +3509,8 @@
 
 	if (vc->vc_mode != KD_TEXT)
 		goto quit;
+
+	tab5_history_live(vc);
 
 	/* undraw cursor first */
 	if (con_is_fg(vc))
--- a/drivers/tty/Kconfig
+++ b/drivers/tty/Kconfig
@@ -41,6 +41,16 @@
 	  If unsure, say Y, or else you won't be able to do much with your new
 	  shiny Linux system :-)
 
+config TAB5_VT_SCROLLBACK
+ bool "Tab5 bounded tty1 software scrollback"
+ depends on VT && FRAMEBUFFER_CONSOLE
+ default n
+ help
+   Keep 128 lines of tty1 glyphs for TIOCLINUX scroll requests, including
+   touch gestures. Uses 40 KiB of static RAM, supports up to 160 columns.
+   Other VTs are unchanged. Output returns to the live view; CSI 3 J
+   clears history. This is a display history, not terminal input storage.
+
 config CONSOLE_TRANSLATIONS
 	depends on VT
 	default y
