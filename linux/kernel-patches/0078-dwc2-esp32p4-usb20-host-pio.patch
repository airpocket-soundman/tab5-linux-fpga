From: Tab5 Linux FPGA maintainers
Subject: [PATCH] usb: dwc2: add ESP32-P4 USB20 host PIO parameters

The Tab5 Type-A connector uses the USB20 HS controller, separate from
USB11 FS (whose Tab5 pins carry I2S). Add its own compatible so the
existing USB11 full-speed parameters remain unchanged. Select the
16-bit UTMI HS PHY as ESP-IDF 5.5.5 does in usb_dwc_ll.h, retaining
full/low-speed device support through the DWC2 host driver.

Force host PIO and disable descriptor DMA while PSRAM DMA coherency is
unverified. Keep LPM and clock gating off until the boot-shim-owned PHY
has Linux wake support. FIFO sizes/channel counts retain DWC2's hardware
inference. The boot shim must enable USB20 clocks/PHY/VBUS beforehand.

Reference for PHY interface (hardware parameters, not copied code):
https://github.com/espressif/esp-idf/blob/v5.5.5/components/hal/esp32p4/include/hal/usb_dwc_ll.h

diff --git a/drivers/usb/dwc2/params.c b/drivers/usb/dwc2/params.c
--- a/drivers/usb/dwc2/params.c
+++ b/drivers/usb/dwc2/params.c
@@ -318,9 +318,37 @@
 	p->power_down = DWC2_POWER_DOWN_PARAM_NONE;
 }
 
+/* USB 2.0 HS controller, distinct from the USB 1.1 FS controller above. */
+static void dwc2_set_esp32p4_otg20_params(struct dwc2_hsotg *hsotg)
+{
+	struct dwc2_core_params *p = &hsotg->params;
+
+	p->otg_caps.hnp_support = false;
+	p->otg_caps.srp_support = false;
+	p->speed = DWC2_SPEED_PARAM_HIGH;
+	p->phy_type = DWC2_PHY_TYPE_PARAM_UTMI;
+	/* ESP-IDF's usb_dwc_ll_gusbcfg_set_utmi_phy() selects 16 bits. */
+	p->phy_utmi_width = 16;
+	p->i2c_enable = false;
+	/* Start in PIO: PSRAM DMA/cache coherency is not validated here. */
+	p->host_dma = false;
+	p->dma_desc_enable = false;
+	p->dma_desc_fs_enable = false;
+	p->g_dma = false;
+	p->g_dma_desc = false;
+	/* The boot shim owns PHY/clock setup; no Linux wake support yet. */
+	p->power_down = DWC2_POWER_DOWN_PARAM_NONE;
+	p->no_clock_gating = true;
+	p->lpm = false;
+	p->lpm_clock_gating = false;
+	p->besl = false;
+	p->hird_threshold_en = false;
+}
+
 const struct of_device_id dwc2_of_match_table[] = {
 	{ .compatible = "brcm,bcm2835-usb", .data = dwc2_set_bcm_params },
 	{ .compatible = "espressif,esp32p4-otg11", .data = dwc2_set_esp32p4_params },
+	{ .compatible = "espressif,esp32p4-otg20", .data = dwc2_set_esp32p4_otg20_params },
 	{ .compatible = "hisilicon,hi6220-usb", .data = dwc2_set_his_params },
 	{ .compatible = "ingenic,jz4775-otg", .data = dwc2_set_jz4775_params },
 	{ .compatible = "ingenic,jz4780-otg", .data = dwc2_set_jz4775_params },
